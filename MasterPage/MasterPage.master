<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage_MasterPage" %>

<%@ Register Src="~/Controls/Header.ascx" TagPrefix="UCH" TagName="Header" %>
<%@ Register Src="~/Controls/Footer.ascx" TagPrefix="UCF" TagName="Footer" %>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script src="../Scripts/jquery-1.10.2.js" type="text/javascript"></script>
    <script type="text/javascript" src="../FUSIONCHARTS/fusioncharts.js"></script>
    <script type="text/javascript" src="../FUSIONCHARTS/themes/fusioncharts.theme.fint.js"></script>
    <link href="../Styles/style-tab.css" rel="stylesheet" />
    <style type="text/css">
        #Master
        {
            /*background-color: #f2ddc2;*/
            background-image: url('../Images/Login1.jpg');
            background-size: 100% 100vh;
            height: 100%;
            left: 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 9999;
        }
        input[type="radio"]
        {
            margin-right: 10px;
            cursor: pointer;
        }
        
        input[type="radio"]:not(old) + label
        {
            cursor: pointer;
        }
        
        .ajax__calendar_container
        {
            font-family: Arial;
            z-index: 1000;
        }
    </style>
    <telerik:RadCodeBlock runat="server" ID="MasterScript">
        <script type="text/javascript">
            function RestartTimerfromMaster() {
                var PageName = document.location.pathname.match(/[^\/]+$/)[0];
                if ((sessionStorage.getItem('EXPIRY') == null) || (sessionStorage.getItem('EXPIRY').toUpperCase() == "TRUE"))
                    window.location = "../Default.aspx";
                if (PageName == 'Request.aspx')
                    Reload = window.setInterval(ReloadLinks, 60000);
            }
            $(window).load(function () { document.getElementById("Master").style.display = "none"; });
        </script>
    </telerik:RadCodeBlock>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body ondragstart="return false;" ondrop="return false;" ondragstart="return false;"
    ondrop="return false;">
    <div id="Master">
        &nbsp;</div>
    <form id="form1" runat="server">
    <div>
        <div id="DivHeader" align="center">
            <table width="100%" style="min-width: 1250px">
                <tr>
                    <td>
                        <UCH:Header ID="Header" runat="server" />
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <span class="btn-blue1 btn-blue2" style="width: 98%; height: 10px; margin-top: 0px;">
                        </span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <%--<uc:menu id="Menu" runat="server" />--%>
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <table id="TblPorterInfo" style="display: none;">
                            <tr>
                                <td width="20%" align="center">
                                    <asp:Image runat="server" ID="ImgWheelChair" ImageUrl="~/Images/BwheelchairRotate.png"
                                        AlternateText="" Height="60" />
                                </td>
                                <td width="60%">
                                    <span class="btn-blue1 btn-blue2" style="width: 100%; font-family: 'Lucida Console';
                                        font-size: 18px; font-weight: bold; height: 26px; padding-top: 3px; text-align: center;"
                                        id="HeaderText" clientidmode="Static" runat="server"></span>
                                    <img src="../Images/shadow.png" style="width: 95%; height: 35px" />
                                </td>
                                <td width="20%" align="center">
                                    <asp:Image runat="server" ID="ImgTrolleyRotate" ImageUrl="~/Images/Bwheelchair.png"
                                        AlternateText="" Height="60" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        <div id="DivContent" align="center">
            <div class="ClassContent">
                <asp:UpdatePanel runat="server" ID="UPContentBody" UpdateMode="Conditional">
                    <ContentTemplate>
                        <asp:ContentPlaceHolder ID="ContentBody" runat="server">
                        </asp:ContentPlaceHolder>
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
        </div>
        <div>
            <%--                <table width="100%" style="margin-top:-20px;">
                    <tr>
                        <td width="20%" align="center">
                            <table>
                                <tr>
                                    <td>
                                        <asp:Image runat="server" ID="ImgTrolley" ImageUrl="~/Images/TrolleyRotate.png" AlternateText="" Height="60" />
                                    </td>
                                    <td>
                                        <asp:Image runat="server" ID="ImageMedicine" ImageUrl="~/Images/Medicine.png" AlternateText="" Height="60" />
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td width="60%"></td>
                        <td width="20%" align="center">
                            <table>
                                <tr>
                                    <td>
                                        <asp:Image runat="server" ID="ImageMedicineRotate" ImageUrl="~/Images/MedicineRotate.png" AlternateText="" Height="60" />
                                    </td>
                                    <td>
                                        <asp:Image runat="server" ID="Image1" ImageUrl="~/Images/Trolley.png" AlternateText="" Height="60" />
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>--%>
            <UCF:Footer ID="Footer" runat="server" />
        </div>
        <asp:Panel ID="PanelFPassword" runat="server" align="center" Style="display: none;
            width: 30%; min-width: 450px;">
            <div id="DivFPassword" clientidmode="Static" align="center" runat="server" class="Shadow">
                <div class="header" align="center" style="height: 15px;">
                    <table width="100%" style="margin-top: -6px;">
                        <tr>
                            <td width="20%">
                            </td>
                            <td align="center">
                                <asp:Label ID="LBLPatientHead" runat="server" Font-Size="14px" ClientIDMode="Static"
                                    CssClass="Configheader">CHANGE PASSWORD </asp:Label>
                            </td>
                            <td width="20%">
                                <asp:ImageButton ID="BtnFPasswordClose" runat="server" ImageUrl="~/Images/close.png"
                                    Style="cursor: pointer; float: right; margin-right: 8px; width: 15px; height: 15px;"
                                    OnClientClick="RestartTimerfromMaster();"></asp:ImageButton>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="headFoot" style="height: 0px; margin-top: -1px;">
                </div>
                <div id="DivFPasswordContent" runat="server" class="Content" style="font-size: 12px;
                    border-radius: 0px 0px 10px 10px; font-family: Arial; font-weight: bold; color: #014454;
                    min-height: 150px; max-height: 150px; overflow-y: auto;">
                    <asp:Panel ID="PnlPassword" runat="server" DefaultButton="BtnSave">
                        <table class="Custfont" style="min-width: 250px; min-height: 140px; font-size: 11px;"
                            cellpadding="5" cellspacing="5">
                            <tr>
                                <td>
                                    CURRENT PASSWORD
                                </td>
                                <td>
                                    <asp:TextBox ID="TxtCurPassword" runat="server" Width="180px" class="Custfont" ClientIDMode="Static"
                                        TextMode="Password"></asp:TextBox>
                                    <asp:Label ID="ErCurrent" runat="server" Text="*" ForeColor="Red" Font-Size="Medium"
                                        ClientIDMode="Static" CssClass="Custfont" Style="visibility: hidden"></asp:Label>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    NEW PASSWORD
                                </td>
                                <td>
                                    <asp:TextBox ID="TxtPassword" runat="server" Width="180px" class="Custfont" ClientIDMode="Static"
                                        TextMode="Password"></asp:TextBox>
                                    <asp:Label ID="ErPassword" runat="server" Text="*" ForeColor="Red" Font-Size="Medium"
                                        ClientIDMode="Static" CssClass="Custfont" Style="visibility: hidden"></asp:Label>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    CONFIRM PASSWORD
                                </td>
                                <td>
                                    <asp:TextBox ID="TxtConfirmPassword" runat="server" Width="180px" class="Custfont"
                                        ClientIDMode="Static" TextMode="Password"></asp:TextBox>
                                    <asp:Label ID="ErCPassword" runat="server" Text="*" ForeColor="Red" Font-Size="Medium"
                                        ClientIDMode="Static" CssClass="Custfont" Style="visibility: hidden"></asp:Label>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <table width="70%" align="center">
                                        <tr>
                                            <td valign="middle" align="center">
                                            </td>
                                            <td align="right">
                                                <asp:Button ID="BtnSave" runat="server" Text="CHANGE" CssClass="ButtonOut" OnClientClick="ValidatePassword();return false;" />
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </asp:Panel>
                </div>
            </div>
            <ajaxToolkit:ModalPopupExtender ID="mpFPassword" runat="server" BehaviorID="mpFPassword"
                PopupControlID="PanelFPassword" TargetControlID="TargetPanelFPassword" CancelControlID="BtnFPasswordClose"
                BackgroundCssClass="modalBackground">
            </ajaxToolkit:ModalPopupExtender>
            <asp:Label ID="TargetPanelFPassword" runat="server"></asp:Label>
        </asp:Panel>
        <asp:Panel ID="PanelDone" runat="server" align="center" Style="display: none; width: 25%;">
            <div id="Div1" clientidmode="Static" align="center" runat="server" class="Shadow">
                <div class="header" align="center" style="height: 15px;">
                    <table width="100%" style="margin-top: -6px;">
                        <tr>
                            <td width="20%">
                            </td>
                            <td align="center">
                                <asp:Label ID="Label3" runat="server" Font-Size="14px" CssClass="Configheader"> DONE </asp:Label>
                            </td>
                            <td width="20%">
                                <asp:ImageButton ID="ClosePanelDone" runat="server" ImageUrl="~/Images/close.png"
                                    Style="cursor: pointer; float: right; margin-right: 8px; width: 15px; height: 15px;">
                                </asp:ImageButton>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="headFoot" style="height: 0px; margin-top: -2px;">
                </div>
                <div class="Content">
                    <table cellpadding="7" cellspacing="3" width="100%" style="min-height: 70px;">
                        <tr>
                            <td>
                                <asp:Image ID="ImageWarning" runat="server" Style="height: 35px; width: 35px; outline: none;"
                                    ImageUrl="~/Images/Done.png" />
                            </td>
                            <td width="80%">
                                <asp:Label ID="LBLResult" ClientIDMode="Static" runat="server" Font-Size="11px" Text="PASSWORD CHANGED SUCCESSFULLY."
                                    CssClass="ConfigFont"> </asp:Label>
                            </td>
                        </tr>
                    </table>
                    <br />
                </div>
            </div>
            <ajaxToolkit:ModalPopupExtender ID="mpwdDone" runat="server" BehaviorID="mpwdDone"
                PopupControlID="PanelDone" TargetControlID="Label5" CancelControlID="ClosePanelDone"
                BackgroundCssClass="modalBackground">
            </ajaxToolkit:ModalPopupExtender>
            <asp:Label ID="Label5" runat="server"></asp:Label>
        </asp:Panel>
        <asp:Panel ID="PanelLoading" runat="server" align="center" Style="display: none;
            width: 250px;">
            <div id="DivLoading" clientidmode="Static" align="center" runat="server" class="Shadow">
                <div class="header" align="center" style="height: 15px;">
                    <table width="100%" style="margin-top: -6px;">
                        <tr>
                            <td width="20%">
                            </td>
                            <td align="center">
                                <asp:Label ID="LBLLoadingHead" runat="server" Font-Size="14px" CssClass="Configheader"> Loading.. </asp:Label>
                            </td>
                            <td width="20%">
                                <asp:ImageButton ID="BtnCloseLoading" runat="server" ImageUrl="~/Images/close.png"
                                    Style="cursor: pointer; float: right; margin-right: 8px; width: 15px; height: 15px;
                                    display: none;"></asp:ImageButton>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="headFoot" style="height: 0px; margin-top: -2px;">
                </div>
                <div class="Content">
                    <table cellpadding="7" cellspacing="3" width="100%" style="min-height: 70px;">
                        <tr>
                            <td align="center">
                                <asp:Image ID="Image1" runat="server" Style="height: 30px; width: 200px; outline: none;"
                                    ImageUrl="~/MImages/LoadingN.gif" />
                            </td>
                        </tr>
                    </table>
                    <br />
                </div>
            </div>
            <ajaxToolkit:ModalPopupExtender ID="MPLoading" runat="server" BehaviorID="MPLoading"
                PopupControlID="PanelLoading" TargetControlID="TargetLabel" CancelControlID="BtnCloseLoading"
                BackgroundCssClass="modalBackground">
            </ajaxToolkit:ModalPopupExtender>
            <asp:Label ID="TargetLabel" runat="server"></asp:Label>
        </asp:Panel>
    </div>
    </form>
</body>
</html>
