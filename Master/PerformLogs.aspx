            var grid, gridMasterTable, pageSize = 15, pageIndex = 0;


            $(document).ready(function () {
                InitChangePassword();

                Sfrom = document.getElementById("<%= HFFrom.ClientID %>").value;
                Sto = document.getElementById("<%= HFTo.ClientID %>").value;
                document.getElementById("txtfromdate").value = Sfrom;
                document.getElementById("txttodate").value = Sto;

                LoadProcess();


                $('textarea').keypress(function (event) {

                    var regex = new RegExp("^[a-zA-Z0-9]+$");
                    var arrValid = ["*", ",","."];
                    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);

                    //alert(key);
                    if (!regex.test(key) && (event.which !== 32) && (event.which !== 13) && (!(arrValid.indexOf(key) > -1))) {
                        event.preventDefault();
                        return false;
                    }

                });



                $('input[type=search]').keypress(function (event) {

                    var regex = new RegExp("^[a-zA-Z0-9]+$");
                    var arrValid = ["*", ",","."];
                    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);

                    //alert(key);
                    if (!regex.test(key) && (event.which !== 32) && (event.which !== 13) && (!(arrValid.indexOf(key) > -1))) {
                        event.preventDefault();
                        return false;
                    }

                });

            });

            function LoadProcess() {
                //sessionStorage.getItem('ROLE', 'CONTROL ROOM');

                PFrom = document.getElementById("txtfromdate").value + "T00:00";
                PTo = document.getElementById("txttodate").value + "T23:59";

                grid = $find('<%= GridPerformLogs.ClientID %>');
                gridMasterTable = $find('<%= GridPerformLogs.ClientID %>').get_masterTableView();
                LoadGrid();
            }

            function DatValidate() {
                var DStatus = ($('#selStatus').val() !== 'ALL') ? $('#selStatus').val() : ''


                PFrom = document.getElementById("txtfromdate").value + "T00:00";
                PTo = document.getElementById("txttodate").value + "T23:59";

                Sfrom = document.getElementById("txtfromdate");
                Sto = document.getElementById("txttodate");

                var returnValue = DatewiseValidate();
                if (returnValue) {
                    document.getElementById("<%= HFFrom.ClientID %>").value = PFrom;
                    document.getElementById("<%= HFTo.ClientID %>").value = PTo;
                    document.getElementById("<%= RStatus.ClientID %>").value = DStatus;
                    document.getElementById("<%= HFReqID.ClientID %>").value = GetReqIDExport();
                    document.getElementById("<%= HFDWExportHeader.ClientID %>").value = BuildHeader();
                    document.getElementById("<%= HFDWSearchQuery.ClientID %>").value = Encrypt($('#TextSearchLocation').val());
                    ShowModalPopUp("modalAlertExport");
                    setTimeout('HideModalPopUp("modalAlertExport");', 3000);
                }
                return returnValue;
            }

        </script>
